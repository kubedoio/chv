{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chv.kubedo.io/schemas/cellhv-openstack-discovery-report-v1.schema.json",
  "title": "CellHV OpenStack discovery report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_status",
    "run_id",
    "recorded_at",
    "started_at",
    "completed_at",
    "openstack_version",
    "nova_version",
    "libvirt_version",
    "cloud_hypervisor_version",
    "host_kernel",
    "candidate",
    "configuration",
    "first_success",
    "first_failure",
    "libvirt_api_or_xml",
    "qemu_specific_assumptions",
    "network_expectation",
    "storage_expectation",
    "core_authority_impact",
    "generic_upstream_option",
    "native_driver_effort",
    "security_risk",
    "maintenance_risk",
    "result",
    "recommended_next_step",
    "evidence",
    "unsupported",
    "cleanup"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_status": {
      "type": "string",
      "enum": ["proposed-not-run", "partial", "complete"]
    },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "openstack_version": { "$ref": "#/$defs/versionValue" },
    "nova_version": { "$ref": "#/$defs/versionValue" },
    "libvirt_version": { "$ref": "#/$defs/versionValue" },
    "cloud_hypervisor_version": { "$ref": "#/$defs/versionValue" },
    "host_kernel": { "$ref": "#/$defs/versionValue" },
    "candidate": { "type": "string", "enum": ["path-a", "path-b", "path-c"] },
    "configuration": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/finding" }
    },
    "first_success": { "$ref": "#/$defs/observedEvent" },
    "first_failure": { "$ref": "#/$defs/observedEvent" },
    "libvirt_api_or_xml": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/finding" }
    },
    "qemu_specific_assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/findingWithSources" }
    },
    "network_expectation": { "$ref": "#/$defs/finding" },
    "storage_expectation": { "$ref": "#/$defs/finding" },
    "core_authority_impact": { "$ref": "#/$defs/finding" },
    "generic_upstream_option": { "$ref": "#/$defs/finding" },
    "native_driver_effort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineer_weeks", "maintained_components", "unsupported_operations", "basis"],
      "properties": {
        "engineer_weeks": { "type": "string", "minLength": 1 },
        "maintained_components": { "$ref": "#/$defs/nonEmptyStrings" },
        "unsupported_operations": { "$ref": "#/$defs/nonEmptyStrings" },
        "basis": { "$ref": "#/$defs/finding" }
      }
    },
    "security_risk": { "$ref": "#/$defs/finding" },
    "maintenance_risk": { "$ref": "#/$defs/finding" },
    "result": {
      "type": "string",
      "enum": ["not-run", "blocked", "inconclusive", "viable", "rejected"]
    },
    "recommended_next_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation", "rationale", "rejected_alternatives", "residual_risks"],
      "properties": {
        "recommendation": {
          "type": "string",
          "enum": ["path-a", "path-b", "path-c", "focused-discovery"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "rejected_alternatives": { "$ref": "#/$defs/nonEmptyStrings" },
        "residual_risks": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceArtifact" }
    },
    "unsupported": { "$ref": "#/$defs/nonEmptyStrings" },
    "cleanup": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evidence_status": { "enum": ["partial", "complete"] } },
        "required": ["evidence_status"]
      },
      "then": {
        "properties": {
          "evidence": { "minItems": 1 },
          "cleanup": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "evidence_status": { "const": "proposed-not-run" } },
        "required": ["evidence_status"]
      },
      "then": {
        "properties": { "result": { "const": "not-run" } }
      }
    },
    {
      "if": {
        "properties": { "evidence_status": { "const": "complete" } },
        "required": ["evidence_status"]
      },
      "then": {
        "properties": {
          "libvirt_api_or_xml": { "minItems": 1 },
          "qemu_specific_assumptions": { "minItems": 1 },
          "network_expectation": { "$ref": "#/$defs/evidenceBackedFinding" },
          "storage_expectation": { "$ref": "#/$defs/evidenceBackedFinding" },
          "core_authority_impact": { "$ref": "#/$defs/evidenceBackedFinding" },
          "result": { "enum": ["blocked", "viable", "rejected"] }
        },
        "anyOf": [
          {
            "properties": {
              "first_success": {
                "properties": {
                  "observed": { "const": true },
                  "evidence_refs": { "minItems": 1 }
                }
              }
            }
          },
          {
            "properties": {
              "first_failure": {
                "properties": {
                  "observed": { "const": true },
                  "evidence_refs": { "minItems": 1 }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "versionValue": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "path", "line_start"],
      "properties": {
        "repository": {
          "type": "string",
          "enum": [
            "https://opendev.org/openstack/nova.git",
            "https://gitlab.com/libvirt/libvirt.git"
          ]
        },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "path": {
          "type": "string",
          "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
        },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidence_refs"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findingWithSources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidence_refs", "source_refs"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceReference" }
        }
      }
    },
    "evidenceBackedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidence_refs"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "observedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "summary", "evidence_refs"],
      "properties": {
        "observed": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256", "redacted"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "kind": {
          "type": "string",
          "enum": ["configuration", "log", "api-payload", "domain-xml", "source-excerpt", "command-output", "report"]
        },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "redacted": { "type": "boolean" }
      }
    }
  }
}
