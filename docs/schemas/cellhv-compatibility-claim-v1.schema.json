{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chv.kubedo.io/schemas/cellhv-compatibility-claim-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["cellhv_core", "vmm", "hypervisor_interface", "network", "storage", "platform", "workload", "qualification", "maintenance_owner", "unsupported", "known_deviations"],
  "properties": {
    "cellhv_core": {
      "type": "object", "additionalProperties": false, "required": ["runtime_service", "version"],
      "properties": { "runtime_service": { "type": "string", "enum": ["chv-agent"] }, "version": { "type": "string", "minLength": 1 } }
    },
    "vmm": {
      "type": "object", "additionalProperties": false, "required": ["backend", "version"],
      "properties": { "backend": { "type": "string", "enum": ["cloud-hypervisor"] }, "version": { "type": "string", "minLength": 1 } }
    },
    "hypervisor_interface": {
      "type": "object", "additionalProperties": false, "required": ["type", "version"],
      "properties": { "type": { "type": "string", "enum": ["native-api", "libvirt-ch", "platform-adapter"] }, "version": { "type": "string", "minLength": 1 } }
    },
    "network": {
      "type": "object", "additionalProperties": false, "required": ["type", "profile"],
      "properties": { "type": { "type": "string", "enum": ["existing-bridge", "cellhv-provider", "libvirt-network", "external-sdn"] }, "profile": { "type": "string", "minLength": 1 } }
    },
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["type", "profile"],
      "properties": { "type": { "type": "string", "enum": ["existing-file-block", "cellhv-provider", "libvirt-storage", "external-storage"] }, "profile": { "type": "string", "minLength": 1 } }
    },
    "platform": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "integration"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "integration": { "type": "string", "enum": ["generic-libvirt", "native-adapter", "generic-upstream-change", "none"] } }
    },
    "workload": {
      "type": "object", "additionalProperties": false, "required": ["guest_os", "architecture", "firmware"],
      "properties": { "guest_os": { "type": "string", "minLength": 1 }, "architecture": { "type": "string", "minLength": 1 }, "firmware": { "type": "string", "minLength": 1 } }
    },
    "qualification": {
      "type": "object", "additionalProperties": false, "required": ["profile", "evidence_digest"],
      "properties": { "profile": { "type": "string", "minLength": 1 }, "evidence_digest": { "type": "string", "minLength": 1 } }
    },
    "maintenance_owner": { "type": "string", "minLength": 1 },
    "unsupported": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "known_deviations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
