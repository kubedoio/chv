[Unit]
Description=CHV Guest Monitoring Agent
Documentation=file:/usr/share/chv-monitor-agent/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chv-monitor
Group=chv-monitor
ExecStart=/usr/bin/chv-monitor-agent /etc/chv-monitor/agent.toml
Restart=on-failure
RestartSec=10
# Outages are expected and handled: the agent spools batches to disk
# and replays them, so restarts stay cheap and frequent.
KillMode=mixed
TimeoutStopSec=10

# The agent's only writable surface is its state directory (spool,
# credential, sequence counters, and the operator-placed one-time
# claim). Everything else is read-only — including /etc/chv-monitor,
# which holds only the config and the manager CA.
StateDirectory=chv-monitor
StateDirectoryMode=0700
LogsDirectory=chv-monitor
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chv-monitor
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
# No capabilities, ever: the agent reads /proc and /etc, opens one
# outbound TLS connection, and nothing else.
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
